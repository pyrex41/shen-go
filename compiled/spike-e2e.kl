(shen.initialise)

(load "../src/compiler.shen")
(set *maximum-print-sequence-size* 100000)

(do (compile-file "onefn.kl" "onefn.tmp") ())
(let Cg (make-code-generator)
  (bc->go Cg "PluginMain" true "onefn.tmp" "onefn_raw.go"))

(go-build-and-load "onefn_raw.go" "PluginMain")

(tak 18 12 6)
