(load-file "../kernel/klambda/toplevel.kl")
(load-file "../kernel/klambda/core.kl")
(load-file "../kernel/klambda/sys.kl")
(load-file "../kernel/klambda/sequent.kl")
(load-file "../kernel/klambda/yacc.kl")
(load-file "../kernel/klambda/reader.kl")
(load-file "../kernel/klambda/prolog.kl")
(load-file "../kernel/klambda/track.kl")
(load-file "../kernel/klambda/load.kl")
(load-file "../kernel/klambda/writer.kl")
(load-file "../kernel/klambda/macros.kl")
(load-file "../kernel/klambda/declarations.kl")
(load-file "../kernel/klambda/t-star.kl")
(load-file "../kernel/klambda/types.kl")
(load-file "../kernel/klambda/dict.kl")
(load-file "../kernel/klambda/init.kl")
(shen.initialise)
(load "../src/compiler.shen")
(set *maximum-print-sequence-size* 100000)

(defun tak (X Y Z) (if (not (< Y X)) Z (tak (tak (- X 1) Y Z) (tak (- Y 1) Z X) (tak (- Z 1) X Y))))
(defun bench-tak (X Y Z N) (if (= N 0) done (let _ (tak X Y Z) (bench-tak X Y Z (- N 1)))))
(defun fib (N) (if (< N 2) N (+ (fib (- N 1)) (fib (- N 2)))))

(pr "=== VM-tak-x20 ===" (stoutput)) (nl)
(let T0 (get-time run) (let _ (bench-tak 24 16 8 20) (let T1 (get-time run) (- T1 T0))))
(pr "=== VM-fib30 ===" (stoutput)) (nl)
(let T0 (get-time run) (let _ (fib 30) (let T1 (get-time run) (- T1 T0))))

(pr "=== compile tak (warm? first build) ===" (stoutput)) (nl)
(do (compile-file "onefn.kl" "onefn.tmp") ())
(let Cg (make-code-generator) (bc->go Cg "PluginMain" true "onefn.tmp" "onefn_raw.go"))
(go-build-and-load "onefn_raw.go" "PluginMain")

(pr "=== compile fib (warm build #2) ===" (stoutput)) (nl)
(do (compile-file "onefn-fib.kl" "onefn-fib.tmp") ())
(let Cg (make-code-generator) (bc->go Cg "FibMain" true "onefn-fib.tmp" "onefn-fib_raw.go"))
(go-build-and-load "onefn-fib_raw.go" "FibMain")

(pr "tak(18,12,6)=" (stoutput)) (tak 18 12 6)
(pr "fib(20)=" (stoutput)) (fib 20)

(pr "=== PLUGIN-tak-x20 ===" (stoutput)) (nl)
(let T0 (get-time run) (let _ (bench-tak 24 16 8 20) (let T1 (get-time run) (- T1 T0))))
(pr "=== PLUGIN-fib30 ===" (stoutput)) (nl)
(let T0 (get-time run) (let _ (fib 30) (let T1 (get-time run) (- T1 T0))))
